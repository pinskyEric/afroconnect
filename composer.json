{
  "name":"africonnect/backend","type":"project","description":"AfriConnect JSON REST API","license":"proprietary",
  "require":{"php":"^8.3","laravel/framework":"^12.0","laravel/sanctum":"^4.0","laravel/reverb":"^1.0","league/flysystem-aws-s3-v3":"^3.0","intervention/image":"^3.11"},
  "require-dev":{"fakerphp/faker":"^1.23","laravel/pint":"^1.20","mockery/mockery":"^1.6","phpunit/phpunit":"^11.0"},
  "autoload":{"psr-4":{"App\\":"app/","Database\\Factories\\":"database/factories/","Database\\Seeders\\":"database/seeders/"}},
  "autoload-dev":{"psr-4":{"Tests\\":"tests/"}},
  "scripts":{"post-autoload-dump":["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump","@php artisan package:discover --ansi"],"test":"@php vendor/bin/phpunit","format":"@php vendor/bin/pint --dirty"},
  "config":{"optimize-autoloader":true,"preferred-install":"dist","sort-packages":true,"allow-plugins":{"php-http/discovery":true}},"minimum-stability":"stable","prefer-stable":true
}