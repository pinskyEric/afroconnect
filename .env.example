MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@africonnect.test
MAIL_FROM_NAME=AfriConnect
SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
AGE_MINIMUM=18
MODERATION_RETENTION_DAYS=365
