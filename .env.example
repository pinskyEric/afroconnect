# Same-origin API path; Next.js forwards it server-side to the configured backend.
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_SERVICE_ADAPTER=laravel
# Server-only proxy target. Local example; use a trusted reachable backend in deployment.
AFRICONNECT_API_PROXY_TARGET=http://localhost:8000
# Public Reverb connection settings; these are not secrets.
NEXT_PUBLIC_REVERB_APP_KEY=local-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
